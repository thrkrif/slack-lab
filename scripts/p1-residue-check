#!/usr/bin/env bash
# B18: 해결된 이벤트(COMPLETED·CLOSED)의 입력 본문이 상태 행·보존 입력·큐 어디에도 남지 않았는지 검사한다.
# 읽기 전용이다. 위반이 있으면 종료 코드 1, 조회 자체가 실패하면 3.
#   PSQL     psql 호출 방법 (기본: docker exec -i slack-lab-postgres-1 psql -U slacklab -d slacklab -At)
#   RABBITCTL rabbitmqctl 호출 방법 (기본: docker exec -i slack-lab-rabbitmq-1 rabbitmqctl)
#   EVENTS_QUEUE 처리 큐 이름 (기본: slack.events)
# 기본 컨테이너 이름은 compose 프로젝트 이름이 slack-lab일 때의 것이다. 다르면 PSQL·RABBITCTL로 덮어쓴다.
set -uo pipefail

PSQL=${PSQL:-"docker exec -i slack-lab-postgres-1 psql -U slacklab -d slacklab -At"}
RMQ=${RABBITCTL:-"docker exec -i slack-lab-rabbitmq-1 rabbitmqctl"}
Q=${EVENTS_QUEUE:-slack.events}

# 조회가 하나라도 실패하면 "잔존물 0"이라고 말하지 않고 검사 불가(3)로 끝낸다.
q() { $PSQL -c "$1" </dev/null 2>/dev/null; }
q "SELECT 1" >/dev/null || { echo "검사 불가: Postgres에 연결할 수 없다"; exit 3; }
queues=$($RMQ list_queues name messages </dev/null 2>/dev/null) || { echo "검사 불가: RabbitMQ에 연결할 수 없다"; exit 3; }

violations=0
fail() { echo "FAIL: $*"; violations=$((violations + 1)); }
# 명령 치환 안의 exit는 서브셸만 끝내므로, 질의는 항상 최상위에서 변수에 담고 그 자리에서 실패를 검사한다.
cannot() { echo "검사 불가: $1"; exit 3; }
count() {
  local v
  v=$(q "$1") || cannot "질의 실패"
  [[ $v =~ ^[0-9]+$ ]] || cannot "숫자가 아닌 응답: $v"
  COUNT=$v
}

count "SELECT count(*) FROM processing_state WHERE state IN ('COMPLETED','CLOSED')"; resolved=$COUNT

# 해결된 건은 입력 본문(input)을 비웠어야 한다(B18).
rows=$(q "SELECT event_id FROM processing_state WHERE state IN ('COMPLETED','CLOSED') AND input IS NOT NULL") || cannot "질의 실패"
while IFS= read -r id; do [ -n "$id" ] && fail "해결됐는데 상태 행에 입력 본문이 남음: $id"; done <<<"$rows"

# 해결된 건은 보존 입력(DLQ·복구·재시도)에 남으면 안 된다.
rows=$(q "SELECT p.event_id FROM preserved_input p JOIN processing_state s USING (event_id) WHERE s.state IN ('COMPLETED','CLOSED')") || cannot "질의 실패"
while IFS= read -r id; do [ -n "$id" ] && fail "해결됐는데 보존 입력이 남음: $id"; done <<<"$rows"

# 상태 행이 없는 보존 입력은 고아다.
rows=$(q "SELECT p.event_id FROM preserved_input p LEFT JOIN processing_state s USING (event_id) WHERE s.event_id IS NULL") || cannot "질의 실패"
while IFS= read -r id; do [ -n "$id" ] && fail "상태 행이 없는 보존 입력(고아): $id"; done <<<"$rows"

# 진행 중인 건이 하나도 없는데 큐에 메시지가 남아 있으면 해결된 이벤트의 본문이 큐에 남은 것이다(.dead는 운영자 몫이라 제외).
count "SELECT count(*) FROM processing_state WHERE state NOT IN ('COMPLETED','CLOSED','DEAD')"; active=$COUNT
ready=$(awk -v q="$Q" '$1==q {print $2}' <<<"$queues"); ready=${ready:-0}
deferred=$(awk -v q="$Q.defer" '$1==q {print $2}' <<<"$queues"); deferred=${deferred:-0}
dead=$(awk -v q="$Q.dead" '$1==q {print $2}' <<<"$queues"); dead=${dead:-0}
[[ $ready =~ ^[0-9]+$ && $deferred =~ ^[0-9]+$ && $dead =~ ^[0-9]+$ ]] || cannot "큐 응답을 읽을 수 없다"
if [ "$active" -eq 0 ] && [ $((ready + deferred)) -gt 0 ]; then
  fail "진행 중인 건이 없는데 큐에 메시지가 남음 (ready=${ready}, defer=${deferred})"
fi

count "SELECT count(*) FROM preserved_input WHERE list_name='dlq'"; dlq=$COUNT
count "SELECT count(*) FROM preserved_input WHERE list_name='recovery'"; recovery=$COUNT
count "SELECT count(*) FROM preserved_input WHERE list_name='retry'"; retry=$COUNT
echo "해결 ${resolved}건 | 진행 중 ${active} | 미해결 DLQ ${dlq} + 복구 ${recovery} (재시도 보존 ${retry}) | 큐 ready ${ready} defer ${deferred} dead ${dead}"

if [ "$violations" -eq 0 ]; then
  echo "OK: 잔존물 0"
else
  echo "위반 ${violations}건"
  exit 1
fi
