#!/usr/bin/env bash
# RAG 검색 품질 평가(M29). 예: scripts/rag-eval --confirm-eval-db | scripts/rag-eval --confirm-eval-db --eval.set=tuning | ... --eval.pairs
# 먼저 현재 DB의 색인을 docs/rag-eval/documents(가상 문서 20개)로 바꾼 뒤(scripts/rag-index --confirm-delete) 평가 질문을 던진다.
# 실제 색인이 들어 있는 DB에서 돌리면 그 색인이 지워진다 — 그래서 --confirm-eval-db를 명시해야 실행한다. 평가용 DB(예: 별도 compose 프로젝트)에서만 쓴다.
# 필요: POSTGRES_URL(평가용 DB를 명시), RAG_ENABLED=true RAG_EMBEDDING_MODEL RAG_EMBEDDING_DIMENSION (+ 평소 .env). 기본은 tuning 세트만 돌린다(final은 --eval.set=final|all). 종료 코드: 0 합격(또는 최종 세트 미실행), 1 불합격, 2 검색 불가·입력 오류
set -euo pipefail
cd "$(dirname "$0")/.."
confirmed=false
args=()
for a in "$@"; do
  if [ "$a" = "--confirm-eval-db" ]; then confirmed=true; else args+=("$a"); fi
done
if [ "$confirmed" != true ]; then
  sed -n '2,5p' "$0" >&2
  echo "중단: 이 명령은 현재 DB의 RAG 색인을 평가용 가상 문서로 바꾼다. 그래도 진행하려면 --confirm-eval-db를 붙인다." >&2
  exit 2
fi
# 어느 DB를 덮어쓰는지 호출자가 명시해야 한다. 기본값(= .env나 메인 DB)으로 우연히 돌지 않게 환경에 POSTGRES_URL이 있어야 한다.
if [ -z "${POSTGRES_URL:-}" ]; then
  echo "중단: 평가용 DB를 POSTGRES_URL로 명시한다(예: POSTGRES_URL=jdbc:postgresql://localhost:5432/slacklab). 기본 DB를 덮어쓰지 않으려는 안전장치다." >&2
  exit 2
fi
echo "평가용 DB로 사용: ${POSTGRES_URL} (색인이 가상 문서로 교체된다)" >&2
# 문서 경로는 환경변수가 아니라 인자로 넘긴다 — scripts/rag-index가 .env를 다시 읽어 환경변수를 덮어쓰기 때문이다.
# DB 주소도 인자로 넘긴다 — scripts/rag-index가 .env를 다시 읽어 POSTGRES_URL을 덮어쓸 수 있어서(보호 장치가 우회된다).
scripts/rag-index --confirm-delete "--rag.index.docs-dir=$PWD/docs/rag-eval/documents" "--postgres.url=$POSTGRES_URL"
./gradlew -q bootJar -x test
JAR=$(ls build/libs/*.jar | grep -v -- '-plain' | head -1)
set -a; source .env; set +a
APP_ROLE=indexer exec java -jar "$JAR" --spring.main.banner-mode=off --logging.level.root=WARN \
  --eval "--postgres.url=$POSTGRES_URL" "${args[@]+"${args[@]}"}"
