#!/usr/bin/env python3
"""알람 입력 왕복 확인(M23·3단계 검증). CloudWatch(SNS) 형식의 알림을 /alerts/cloudwatch로 보내고, 알람 채널에 봇이 올린 리포트를 읽는다.
실제 테스트 채널에 글이 올라간다(확인 단계 없음). 같은 알람 이름·상태 변경 시각은 같은 작업이므로 실행마다 시각을 새로 만든다.

사용: ALERT_SECRET=... scripts/alert-roundtrip "<알람 이름>" "<알람 설명>" "<상태 변경 사유>" [재전송 횟수=0]
환경: .env의 SLACK_BOT_TOKEN·SLACK_TEST_CHANNEL(알람 채널과 같아야 한다), ALERT_SECRET(서버와 같은 값), ALERT_URL(기본 http://localhost:8080)
재전송 횟수 N: 같은 알림을 N번 더 보낸다(SNS 재전송 흉내) — 리포트는 정확히 하나여야 한다.

이번 실행의 리포트만 센다: 우리 봇이 쓴 메시지 중 메타데이터의 event_id가 이 알람의 이벤트 ID("alert-" + SHA-256(cloudwatch|계정|리전|이름|시각)
앞 16바이트 hex)와 같은 것. 실패 안내는 리포트로 세지 않고 실패로 본다. 첫 리포트가 보인 뒤 15초 더 관찰해 늦은 중복을 잡는다.
종료 코드: 0 리포트 정확히 1개, 1 없음(시간 초과)·2개 이상·실패 안내, 2 수신 거절(HTTP 200이 아님), 3 Slack API 오류
"""
import datetime
import hashlib
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def load_env():
    env = dict(os.environ)
    path = os.path.join(ROOT, ".env")
    if os.path.exists(path):
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env.setdefault(k, v.strip().strip('"').strip("'"))
    return env


ENV = load_env()
TOKEN, CHANNEL, SECRET = ENV["SLACK_BOT_TOKEN"], ENV["SLACK_TEST_CHANNEL"], ENV["ALERT_SECRET"]
URL = ENV.get("ALERT_URL", "http://localhost:8080").rstrip("/")


def slack(method, query=None):
    req = urllib.request.Request(f"https://slack.com/api/{method}" + ("?" + urllib.parse.urlencode(query) if query else ""),
                                 headers={"Authorization": f"Bearer {TOKEN}"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)


def send(body):
    req = urllib.request.Request(f"{URL}/alerts/cloudwatch", data=body.encode(), method="POST",
                                 headers={"Content-Type": "text/plain; charset=UTF-8", "X-Alert-Secret": SECRET})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code


FAILURE_PREFIXES = ("죄송해요, 지금 답변을 만들지 못했어요", "알람 분석을 만들지 못했어요")
OBSERVE_AFTER_FIRST = 15
ACCOUNT, REGION = "000000000000", "ap-northeast-2"


def event_id(name, changed):
    # CloudWatchAlertNormalizer: "alert-" + SHA-256("cloudwatch|계정|리전|이름|시각")의 앞 16바이트(hex 32자). 공식은 단위 테스트가 고정한다.
    return "alert-" + hashlib.sha256(f"cloudwatch|{ACCOUNT}|{REGION}|{name}|{changed}".encode()).hexdigest()[:32]


def report_for(msg, bot, eid):
    meta = (msg.get("metadata") or {}).get("event_payload") or {}
    return msg.get("user") == bot and meta.get("event_id") == eid


def main():
    if len(sys.argv) < 4:
        sys.exit(__doc__)
    name, desc, reason = sys.argv[1:4]
    repeats = int(sys.argv[4]) if len(sys.argv) > 4 else 0
    deadline = time.time() + 180  # 전체 실행 상한
    auth = slack("auth.test")
    if not auth.get("ok"):
        sys.exit(f"Slack API 오류: {auth.get('error')}")
    bot = auth["user_id"]
    changed = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000+0000")
    eid = event_id(name, changed)
    alarm = {"AlarmName": name, "AlarmDescription": desc, "NewStateValue": "ALARM", "NewStateReason": reason,
             "StateChangeTime": changed, "Region": REGION, "AWSAccountId": ACCOUNT,
             "Trigger": {"MetricName": "PendingThreads", "Namespace": "Custom/Hikari"}}
    body = json.dumps({"Type": "Notification", "MessageId": f"m-{int(time.time() * 1000)}", "Message": json.dumps(alarm, ensure_ascii=False)},
                      ensure_ascii=False)
    since = time.time() - 1
    codes = [send(body) for _ in range(1 + repeats)]
    print(f"수신 응답 {codes}")
    if any(c != 200 for c in codes):
        sys.exit(2)
    first_seen = None
    mine = []
    while time.time() < deadline:
        res = slack("conversations.history", {"channel": CHANNEL, "oldest": f"{since:.6f}", "limit": 100, "include_all_metadata": "true"})
        if not res.get("ok"):
            print(f"Slack API 오류: {res.get('error')}")
            sys.exit(3)
        mine = [m for m in res.get("messages", []) if report_for(m, bot, eid)]
        if mine and first_seen is None:
            first_seen = time.time()
        if first_seen is not None and time.time() - first_seen >= OBSERVE_AFTER_FIRST:
            break
        time.sleep(2)
    if not mine:
        print("시간 초과: 이 알람의 리포트 없음")
        sys.exit(1)
    print(f"이 알람의 봇 메시지 {len(mine)}개 (첫 리포트까지 {first_seen - since:.1f}s, 이후 {OBSERVE_AFTER_FIRST}s 더 관찰)")
    for m in mine:
        print("-----")
        print(m.get("text", ""))
    print("-----")
    failures = [m for m in mine if m.get("text", "").startswith(FAILURE_PREFIXES)]
    if failures:
        print("실패 안내가 올라왔다")
        sys.exit(1)
    if len(mine) != 1:
        print(f"리포트가 정확히 1개여야 하는데 {len(mine)}개다")
        sys.exit(1)


main()
